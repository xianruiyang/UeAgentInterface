+	{
+		if (Phase == EPackageReloadPhase::OnPackageFixup && Event)
+		{
+			// These queues are not reflected references. Preserve only pending
+			// changes while node references are repointed to replacement assets.
+			for (const TPair<UObject*, UObject*>& Pair : Event->GetRepointedObjects())
+			{
+				const UInputAction* OldAction = Cast<UInputAction>(Pair.Key);
+				if (!OldAction) continue;
+				const UInputAction* NewAction = Cast<UInputAction>(Pair.Value);
+				for (TSet<const UInputAction*>* Pending : {&UInputAction::ActionsWithModifiedValueTypes, &UInputAction::ActionsWithModifiedTriggers})
+				{
+					if (Pending->Remove(OldAction) && NewAction) Pending->Add(NewAction);
+				}
+			}
+		}
