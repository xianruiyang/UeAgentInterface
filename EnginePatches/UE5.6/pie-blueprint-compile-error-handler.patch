@@ -0,0 +1,28 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Features/IModularFeature.h"
+
+class UBlueprint;
+struct FRequestPlaySessionParams;
+
+/** Optional request-aware policy for native PIE Blueprint compilation errors. */
+class IPIEBlueprintCompileErrorHandler : public IModularFeature
+{
+public:
+	// Exported so consumers cannot silently link against an engine without this hook.
+	static UNREALED_API FName GetModularFeatureName();
+
+	/** Called on the game thread after native compilation, before the error dialog
+	 * or PIE world creation. Return true only for a request owned by this handler
+	 * to cancel through the normal EndPIE/navigation/CancelPIE cleanup path.
+	 * ErroredBlueprints contains native reported errors; it may be empty when a
+	 * prior interactive choice suppressed a Blueprint's display warning.
+	 * Observe/copy errors here; do not reenter play-session lifecycle APIs.
+	 * False preserves the editor's existing behavior for that request.
+	 */
+	virtual bool CancelOnBlueprintCompileErrors(const FRequestPlaySessionParams& Request,
+		const TArray<UBlueprint*>& ErroredBlueprints) = 0;
+};
