+const FBoolProperty* FEditConditionContext::GetToggleProperty(const FProperty* Property, const TSharedPtr<FEditConditionExpression>& Expression)
+{
+	if (!Property || Property->HasMetaData(TEXT("HideEditConditionToggle"))) return nullptr;
+	const FBoolProperty* ConditionalProperty = GetSingleBoolProperty(Property, Expression);
+	if (!ConditionalProperty) return nullptr;
+	const bool bIsInlineEditCondition = ConditionalProperty->HasMetaData(TEXT("InlineEditConditionToggle"));
+	const bool bIsEditable = ConditionalProperty->HasAllPropertyFlags(CPF_Edit);
+	if (UE::PropertyEditor::Private::bShowInlineEditConditionToggleWhenNotSpecifiedAndNotEditable
+		&& bIsInlineEditCondition == bIsEditable)
+	{
+		return ConditionalProperty;
+	}
+	if (bIsInlineEditCondition)
+	{
+		if (!bIsEditable)
+		{
+			UE_LOG(LogPropertyNode, Warning, TEXT("Property being used as inline edit condition is not editable, but has InlineEditConditionToggle flag. Field \"%s\" in class \"%s\"."), *ConditionalProperty->GetNameCPP(), *Property->GetOwnerStruct()->GetName());
+		}
+		return ConditionalProperty;
+	}
+	return nullptr;
