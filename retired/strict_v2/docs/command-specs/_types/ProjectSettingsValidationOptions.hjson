definition: {
  additional_fields: false
  fields: {
    allow_unknown_fields: { default: false, default_state: defined, description_zh: "允许跳过未知字段", required: false, type: bool }
    fail_on_requires_restart: { default: false, default_state: defined, description_zh: "遇到需要重启的字段时阻断", required: false, type: bool }
    fail_on_unsupported_field: { default: true, default_state: defined, description_zh: "不可编辑字段是否作为错误", required: false, type: bool }
    preserve_unknown_fields: { default: false, default_state: defined, description_zh: "allow_unknown_fields 别名", required: false, type: bool }
    schema_mismatch_policy: { default: fail, default_state: defined, description_zh: "字段 schema hash 不一致策略", enum_values: [fail, apply_matching_fields, dry_run_only], required: false, type: enum }
  }
  kind: object
}
schema: uai.command_spec.shared_type.v1
type_id: ProjectSettingsValidationOptions
