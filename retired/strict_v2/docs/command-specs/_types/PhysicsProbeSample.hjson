definition: {
  additional_fields: false
  fields: {
    actor_id: { default_state: none, description_zh: "actor id", required: false, type: string }
    awake: { default_state: none, description_zh: "刚体是否 awake", required: false, type: bool }
    component: { default_state: none, description_zh: "PrimitiveComponent 名", required: false, type: string }
    location: { default_state: none, description_zh: "固定步长推进后的 UE world location（cm）", required: false, type: object, type_ref: "shared:Vector3" }
    start_location: { default_state: none, description_zh: "probe 前 UE world location（cm）", required: false, type: object, type_ref: "shared:Vector3" }
    velocity: { default_state: none, description_zh: "推进后的 world-space 线速度（cm/s）", required: false, type: object, type_ref: "shared:Vector3" }
    velocity_size: { default_state: none, description_zh: "world-space 线速度模长（cm/s）", minimum: 0, required: false, type: number }
    z_delta: { default_state: none, description_zh: "location.Z-start_location.Z（cm）", required: false, type: number }
  }
  kind: object
}
schema: uai.command_spec.shared_type.v1
