definition: {
  additional_fields: false
  fields: {
    in_viewport: { default_state: none, description_zh: "点是否位于当前 viewport 像素范围", required: false, type: bool }
    overridden: { default_state: none, description_zh: "采样点是否由调用方覆盖", required: false, type: bool }
    pixel_step: { default_state: none, description_zh: "像素差分步长", minimum: 0.001, required: false, type: number }
    valid: { default_state: none, description_zh: "投影是否有效", required: false, type: bool }
    x: { default_state: none, description_zh: "Level Editor viewport pixel X；左上原点、向右为正", required: false, type: number }
    y: { default_state: none, description_zh: "Level Editor viewport pixel Y；左上原点、向下为正", required: false, type: number }
  }
  kind: object
}
schema: uai.command_spec.shared_type.v1
type_id: ProbeScreenPoint
version: 1
