definition: {
  additional_fields: false
  fields: {
    field: { default_state: none, description_zh: "待检查字段名", required: true, type: string }
    op: { default: "==", default_state: defined, description_zh: "比较运算", enum_values: ["==", "!=", ">", ">=", "<", "<=", contains], required: false, type: enum }
    row_name: { default_state: none, description_zh: "待检查的 DataTable row name", required: true, type: string }
    value: { default_state: none, description_zh: "期望值文本", required: false, type: string }
    value_text: { default_state: none, description_zh: "value 别名；反射比较所使用的文本", required: false, type: string }
  }
  kind: object
}
schema: uai.command_spec.shared_type.v1
type_id: DataTableSampleCheck
version: 1
