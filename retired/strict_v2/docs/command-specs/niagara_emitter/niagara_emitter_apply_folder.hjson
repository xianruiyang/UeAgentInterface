status: active
types: {}
verification: {
  assertions: [
    { expected: complete, id: status_complete, operator: equals, source: returns.status }
    { expected: true, id: asset_saved, operator: equals, source: returns.saved }
    { expected: 0, id: compile_error_free, operator: equals, source: returns.compile_error_count }
