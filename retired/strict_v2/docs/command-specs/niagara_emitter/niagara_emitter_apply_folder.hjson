    rollback_succeeded: { description_zh: "回滚是否成功", required: true, type: bool }
    saved: { description_zh: "目标 package 是否已持久化并通过文件读回", required: true, type: bool }
    stack_issue_count: { description_zh: "阻断完成态的 Niagara stack error 总数", required: true, type: integer }
    stack_warning_count: { description_zh: "非阻断的 Niagara stack warning 总数", required: true, type: integer }
    status: { description_zh: "complete；显式不保存时为 applied_in_memory", required: true, type: string }
    units_checked: { description_zh: "preflight 检查单元数", required: true, type: integer }
  }
  state: defined
}
