status: active
types: {}
verification: {
  assertions: [
    { id: result_present, operator: exists, source: returns.saved }
    { id: state_readback_present, operator: exists, source: methods.state_readback.graphs }
  ]
  failure_policy: fail_overall
  methods: [
    { id: result, kind: result_assertion }
    { command: blueprint_inspect_nodes, id: state_readback, kind: command_readback, params_mapping: { asset_path: params.asset_path, graph_name: params.graph_name } }
  ]
  required: true
  state: defined
}
