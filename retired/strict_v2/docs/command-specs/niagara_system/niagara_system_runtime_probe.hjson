params: {
  constraints: []
  fields: {
    advance_mode: { default: advance_simulation, default_state: defined, description_zh: "C++ 实现读取的 advance_mode 参数", required: false, type: string }
    actor_id: { default_state: none, description_zh: "current_level_component 只读采样的 Actor 名称或标签；必须与 component 同时提供", required: false, type: string }
