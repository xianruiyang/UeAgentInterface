    include_each_tick: { default: true, default_state: defined, description_zh: "C++ 实现读取的 include_each_tick 参数", required: false, type: bool }
    include_snapshots: { default: true, default_state: defined, description_zh: "C++ 实现读取的 include_snapshots 参数", required: false, type: bool }
    open_editor_if_needed: { default: false, default_state: defined, description_zh: "C++ 实现读取的 open_editor_if_needed 参数", required: false, type: bool }
    pause_after_probe: { default: false, default_state: defined, description_zh: "C++ 实现读取的 pause_after_probe 参数", required: false, type: bool }
	particle_attributes: { default_state: none, description_zh: "需要从每个 CPU stateful Emitter 的当前粒子数据集中采样的规范属性名，精确匹配且最多 16 项", item_type: string, required: false, type: array }
    measure_performance: { default: false, default_state: defined, description_zh: "为 simulate 分支启用逐步 host wall-clock 计时；不隐式等待 GPU 完成", required: false, type: bool }
    performance_warmup_ticks: { default: 0, default_state: defined, description_zh: "从 tick_count 开头排除的 warmup 步数；启用计时时必须小于 tick_count", required: false, type: integer }
    probe_mode: { default_state: none, description_zh: "sample_mode 的旧兼容别名；仅在未提供 sample_mode 时读取", required: false, type: string }
    require_paused: { default: true, default_state: defined, description_zh: "C++ 实现读取的 require_paused 参数", required: false, type: bool }
    reset_preview: { default: true, default_state: defined, description_zh: "C++ 实现读取的 reset_preview 参数", required: false, type: bool }
    sample_mode: { default: simulate, default_state: defined, description_zh: "C++ 实现读取的 sample_mode 参数", required: false, type: string }
    target_frame: { default: 0, default_state: defined, description_zh: "C++ 实现读取的 target_frame 参数", required: false, type: number }
	max_particle_samples: { default: 64, default_state: defined, description_zh: "每个 Emitter 最多采样的粒子数，1..1024；请求属性时才产生采样成本", required: false, type: integer }
    tick_count: { default: 3, default_state: defined, description_zh: "C++ 实现读取的 tick_count 参数", required: false, type: integer }
    tick_delta_seconds: { default_state: none, description_zh: "C++ 实现读取的 tick_delta_seconds 参数", required: false, type: number }
    use_transient_component: { default: false, default_state: defined, description_zh: "C++ 实现读取的 use_transient_component 参数", required: false, type: bool }
    use_transient_preview_component: { default: false, default_state: defined, description_zh: "C++ 实现读取的 use_transient_preview_component 参数", required: false, type: bool }
  }
  state: defined
}
