    },
    {
      "case_id": "asset_project_read.registry",
      "family": "registry",
      "provider_binding": "asset_project.read.registry_record",
      "oracle": "FAssetData identity and class facts are read from the Ticket-resolved registry record"
    },
    {
      "case_id": "asset_project_read.editor",
      "family": "editor",
      "provider_binding": "asset_project.read.editor_dirty_resources",
      "oracle": "owned clean package is observed through the explicit editor-resource environment without changing dirty state"
    },
    {
      "case_id": "asset_project_read.project",
      "family": "project",
      "provider_binding": "asset_project.read.project_summary",
      "oracle": "project facts come from the project object resolved by the frozen ExecutionContextRef"
    },
    {
      "case_id": "asset_project_read.config",
      "family": "config",
      "provider_binding": "asset_project.read.config_section",
