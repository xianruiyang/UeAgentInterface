  "e2_scenarios": [
    {
      "case_id": "actor_is_created_with_exact_identity_and_placement",
      "descriptor_id": "uai.operation.world.actor.create",
      "oracle": "world.actors plus exact class, label, tags, folder, and world-transform readback identify the new actor",
      "negative_oracle": "missing class, invalid class, or invalid placement leaves zero tagged actors and preserves the level dirty state"
    },
    {
      "case_id": "wall_segments_cover_wall_except_opening",
      "descriptor_id": "uai.operation.world.wall.create_with_opening",
      "oracle": "world.read.actors plus actor transform and mesh-bounds readback projected into the declared wall frame",
      "negative_oracle": "invalid basis, out-of-bounds opening, missing class, or missing mesh leaves zero spawned actors"
    },
    {
      "case_id": "data_layer_instance_is_new_and_exact",
      "descriptor_id": "uai.operation.world.data_layer_instance.create",
      "oracle": "world.read.data_layers returns the new exact instance, parent, and explicit initial state",
      "negative_oracle": "existing instance is a create conflict and invalid parent leaves zero new instances"
    },
    {
      "case_id": "data_layer_relation_matches_requested_set",
      "descriptor_id": "uai.operation.world.data_layer_relation.update",
      "oracle": "world.read.data_layer_membership reads each actor membership or data-layer parent relation independently",
      "negative_oracle": "any unresolved subject or collection fails before all relation mutations"
    },
    {
      "case_id": "data_layer_state_matches_explicit_changes",
      "descriptor_id": "uai.operation.world.data_layer_state.update",
      "oracle": "world.read.data_layers independently reads the exact state and short name",
      "negative_oracle": "unknown state or target fails before all state mutations"
    },
    {
      "case_id": "actor_hlod_membership_matches",
      "descriptor_id": "uai.operation.world.actor_hlod_layer.update",
      "oracle": "world.read.actor_hlod reads the actual HLOD Layer of every target actor",
      "negative_oracle": "unresolved actor or HLOD Layer fails before all membership mutations"
    },
    {
      "case_id": "actor_streaming_policy_matches",
      "descriptor_id": "uai.operation.world.actor_streaming_policy.update",
      "oracle": "world.read.actor_streaming_policy reads runtime grid and spatially-loaded state from every target actor",
      "negative_oracle": "invalid runtime-grid intent or unresolved actor fails before all policy mutations"
    },
    {
      "case_id": "streaming_relation_is_created_with_placement",
      "descriptor_id": "uai.operation.world.streaming_relation.create",
      "oracle": "world.read.streaming_levels returns exact asset, class, state, and canonical placement",
      "negative_oracle": "missing asset, invalid class, or invalid placement leaves zero new streaming relations"
    },
    {
      "case_id": "streaming_relation_state_settles_and_matches",
      "descriptor_id": "uai.operation.world.streaming_relation.state.update",
      "oracle": "world.read.streaming_levels independently reads loaded, visible, and canonical placement after settle",
      "negative_oracle": "unknown relation or invalid placement leaves loaded, visible, placement, and current level unchanged"
    },
    {
      "case_id": "world_partition_streaming_flag_matches",
      "descriptor_id": "uai.operation.world.world_partition_streaming.update",
      "oracle": "world.read.world_partition independently reads the exact world's persisted streaming-enabled flag",
      "negative_oracle": "non-World-Partition world fails without dirtying the world package"
    },
    {
      "case_id": "level_game_mode_override_matches",
      "descriptor_id": "uai.operation.world.level_game_mode.update",
      "oracle": "world.property independently reads the exact level WorldSettings DefaultGameMode class after map save",
      "negative_oracle": "an unresolved or non-GameModeBase class leaves WorldSettings and level dirty state unchanged"
    }
  ],
